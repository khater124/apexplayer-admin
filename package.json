{
    "name": "apexplayer-admin",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "build": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/main.cjs --packages=external",
        "migrate": "tsx scripts/migrate.ts",
        "start": "node dist/main.cjs",
        "dev": "tsx src/main.ts"
    },
    "dependencies": {
        "bcryptjs": "3.0.3",
        "cookie-parser": "1.4.7",
        "express": "5.2.1",
        "express-rate-limit": "8.5.2",
        "jsonwebtoken": "9.0.3",
        "pg": "8.21.0",
        "zod": "4.4.3"
    },
    "devDependencies": {
        "@types/cookie-parser": "1.4.10",
        "@types/express": "5.0.6",
        "@types/jsonwebtoken": "9.0.10",
        "@types/node": "20.19.9",
        "@types/pg": "8.20.0",
        "esbuild": "0.27.2",
        "tsx": "4.21.0",
        "typescript": "5.9.3"
    }
}
